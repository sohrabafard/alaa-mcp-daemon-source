{
  "$schema": "../alaa-mcp-daemon.schema.json",
  "version": 1,
  "runtime": {
    "log_dir": "./logs",
    "state_dir": "./state",
    "max_parallel_starts": 1,
    "watch_interval": "1s",
    "reload_debounce": "250ms"
  },
  "defaults": {
    "restart": {
      "policy": "always",
      "max_attempts": 5,
      "window": "60s",
      "backoff_initial": "1s",
      "backoff_max": "30s"
    },
    "shutdown": {
      "grace_period": "8s"
    },
    "logs": {
      "max_bytes": 10485760,
      "backups": 5
    }
  },
  "commands": {
    "serena-http": {
      "program": "C:/Users/Alaa/.local/bin/serena.exe",
      "args": [
        "start-mcp-server",
        "--transport",
        "streamable-http",
        "--host",
        "${host}",
        "--port",
        "${port}",
        "--context",
        "${context}",
        "--project",
        "${project_path}",
        "--open-web-dashboard",
        "false"
      ],
      "cwd": "${project_path}",
      "priority": "below_normal"
    },
    "sentry-http": {
      "program": "${node_path}",
      "args": [
        "--env-file=${config_dir}/sentry.env",
        "${proxy_script}",
        "--host",
        "${host}",
        "--port",
        "${port}",
        "--server",
        "stream",
        "--endpoint",
        "/mcp",
        "--",
        "${node_path}",
        "${sentry_script}",
        "--host",
        "${sentry_host}",
        "--insecure-http"
      ],
      "cwd": "${config_dir}",
      "env": {
        "MCP_SKILLS": "inspect,seer"
      },
      "priority": "below_normal"
    }
  },
  "services": [
    {
      "id": "serena-auth",
      "description": "Shared Serena endpoint for the auth project",
      "command": "serena-http",
      "enabled": false,
      "autostart": false,
      "vars": {
        "host": "127.0.0.1",
        "port": "42100",
        "context": "ide",
        "project_path": "D:\\Sohrab\\Project\\auth"
      },
      "claims": [
        {
          "type": "tcp",
          "host": "${host}",
          "port": "${port}"
        }
      ],
      "exclusive_keys": [
        "serena-project:${project_path}"
      ],
      "readiness": {
        "type": "tcp",
        "host": "${host}",
        "port": "${port}",
        "startup_timeout": "90s",
        "interval": "15s",
        "timeout": "2s",
        "failure_threshold": 3
      }
    },
    {
      "id": "serena-comment",
      "description": "Shared Serena endpoint for the comment service",
      "command": "serena-http",
      "enabled": false,
      "autostart": false,
      "vars": {
        "host": "127.0.0.1",
        "port": "42101",
        "context": "ide",
        "project_path": "D:\\Sohrab\\Project\\comment-service"
      },
      "claims": [
        {
          "type": "tcp",
          "host": "${host}",
