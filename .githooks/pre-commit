#!/bin/sh
# Normalize staged text only. The Python helper updates index blobs directly,
# so unstaged edits never become staged as a side effect of a commit.
set -eu

repo_root="$(git rev-parse --show-toplevel)"
if command -v python3 >/dev/null 2>&1; then
  exec python3 "$repo_root/scripts/normalize_text_files.py" --staged
fi
if command -v python >/dev/null 2>&1; then
  exec python "$repo_root/scripts/normalize_text_files.py" --staged
fi

printf '%s\n' 'pre-commit requires Python 3; run scripts/install-git-hooks.ps1 after installing Python.' >&2
exit 1
